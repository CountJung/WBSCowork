{
  "name": "wbs-task",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/run-next.ts dev",
    "dev:debug": "node --import tsx scripts/run-next.ts dev --inspect",
    "db:check": "node --import tsx scripts/check-db.ts",
    "build": "vinext build",
    "start": "node --import tsx scripts/run-next.ts start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:fsd": "node --import tsx scripts/check-fsd-boundaries.ts",
    "test": "node --import tsx scripts/run-tests.ts",
    "test:unit": "node --import tsx scripts/run-tests.ts --unit",
    "test:db:up": "node --import tsx scripts/test-database.ts up",
    "test:db:down": "node --import tsx scripts/test-database.ts down",
    "test:db:status": "node --import tsx scripts/test-database.ts status",
    "build:next": "node --import tsx scripts/run-next.ts build",
    "dev:sites": "vinext dev",
    "start:sites": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --inspector-port 0",
    "test:sites:auth": "node scripts/test-sites-auth.mjs",
    "db:generate": "drizzle-kit generate",
    "test:sites:storage": "node --import tsx --experimental-test-module-mocks scripts/test-sites-storage.ts",
    "test:sites:http": "node scripts/test-sites-http.mjs",
    "test:sites:browser": "node scripts/test-sites-http.mjs --browser"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "drizzle-orm": "0.45.2",
    "frappe-gantt": "^1.2.2",
    "mariadb": "^3.5.2",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "babel-plugin-react-compiler": "1.0.0",
    "docx": "^9.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pptxgenjs": "^4.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
